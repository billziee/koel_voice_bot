# KOEL backend — copy to backend/.env and adjust. All vars are KOEL_-prefixed.

KOEL_ENVIRONMENT=development
KOEL_DEBUG=true
KOEL_AWS_REGION=ap-south-1

# Logging (PRD §08)
KOEL_LOG_LEVEL=INFO
KOEL_LOG_JSON=true

# OpenTelemetry (PRD §08) — leave endpoint empty to disable export in dev
KOEL_OTEL_ENABLED=true
KOEL_OTEL_CONSOLE_EXPORT=false
# KOEL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# FastAPI inbound auto-instrumentation: off (instrumentor crashes on CORS
# preflight); manual per-hop spans still provide latency tracing.
KOEL_OTEL_INSTRUMENT_FASTAPI=false

# CORS — origins allowed to call the API. "*" in dev (Bearer auth, no cookies).
KOEL_CORS_ALLOW_ORIGINS=*

# Auth (PRD §08) — CHANGE the secret outside dev
KOEL_JWT_SECRET=dev-only-insecure-secret-change-me
KOEL_JWT_ACCESS_TTL_SECONDS=3600
KOEL_JWT_WS_TTL_SECONDS=120

# Data stores
KOEL_REDIS_URL=redis://localhost:6379/0
KOEL_DATABASE_URL=postgresql+asyncpg://koel:koel@localhost:5432/koel

# Inter-service URLs (the orchestrator fans out to these)
KOEL_STT_SVC_URL=http://localhost:8101
KOEL_NLP_SVC_URL=http://localhost:8102
KOEL_TTS_SVC_URL=http://localhost:8103
KOEL_CRM_SVC_URL=http://localhost:8104

# NLP provider — "stub" (deterministic, offline) or "groq" (live inference)
KOEL_NLP_PROVIDER=stub
# Groq (https://console.groq.com). Set KOEL_NLP_PROVIDER=groq and supply a key.
# KOEL_GROQ_API_KEY=gsk_...
KOEL_GROQ_MODEL=llama-3.3-70b-versatile
KOEL_GROQ_BASE_URL=https://api.groq.com/openai/v1
KOEL_GROQ_TEMPERATURE=0.3
KOEL_GROQ_MAX_TOKENS=512
KOEL_GROQ_TIMEOUT_S=8.0
