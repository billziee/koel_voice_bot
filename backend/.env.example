# KOEL backend — copy to backend/.env and adjust. All vars are KOEL_-prefixed.

KOEL_ENVIRONMENT=development
KOEL_DEBUG=true
KOEL_AWS_REGION=ap-south-1

# Logging (PRD §08)
KOEL_LOG_LEVEL=INFO
KOEL_LOG_JSON=true

# OpenTelemetry (PRD §08) — leave endpoint empty to disable export in dev
KOEL_OTEL_ENABLED=true
KOEL_OTEL_CONSOLE_EXPORT=false
# KOEL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# FastAPI inbound auto-instrumentation: off (instrumentor crashes on CORS
# preflight); manual per-hop spans still provide latency tracing.
KOEL_OTEL_INSTRUMENT_FASTAPI=false

# CORS — origins allowed to call the API. "*" in dev (Bearer auth, no cookies).
KOEL_CORS_ALLOW_ORIGINS=*

# Auth (PRD §08) — CHANGE the secret outside dev
KOEL_JWT_SECRET=dev-only-insecure-secret-change-me
KOEL_JWT_ACCESS_TTL_SECONDS=3600
KOEL_JWT_WS_TTL_SECONDS=120

# Data stores
KOEL_REDIS_URL=redis://localhost:6379/0
KOEL_DATABASE_URL=postgresql+asyncpg://koel:koel@localhost:5432/koel

# Inter-service URLs (the orchestrator fans out to these)
KOEL_STT_SVC_URL=http://localhost:8101
KOEL_NLP_SVC_URL=http://localhost:8102
KOEL_TTS_SVC_URL=http://localhost:8103
KOEL_CRM_SVC_URL=http://localhost:8104

# --- Groq (one key powers NLP + STT + TTS) — https://console.groq.com ---
# KOEL_GROQ_API_KEY=gsk_...
KOEL_GROQ_BASE_URL=https://api.groq.com/openai/v1

# NLP provider — "stub" (deterministic, offline) or "groq" (live inference)
KOEL_NLP_PROVIDER=stub
KOEL_GROQ_MODEL=llama-3.3-70b-versatile
KOEL_GROQ_TEMPERATURE=0.3
KOEL_GROQ_MAX_TOKENS=512
KOEL_GROQ_TIMEOUT_S=8.0

# STT provider — "stub" (type-to-talk) or "groq" (live Whisper). Real audio only.
KOEL_STT_PROVIDER=stub
KOEL_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Sarvam AI Saaras (primary STT) — set the key to enable; Sarvam then becomes
# the STT provider and Whisper (if also enabled) is its fallback.
# KOEL_SARVAM_API_KEY=sk_...
KOEL_SARVAM_STT_MODEL=saaras:v3

# TTS provider — "stub" (sized silent PCM) or "groq" (live Orpheus neural TTS).
# Orpheus needs one-time org-admin terms acceptance in the Groq console; until
# then the live provider degrades to the stub.
KOEL_TTS_PROVIDER=stub
KOEL_GROQ_ORPHEUS_MODEL=canopylabs/orpheus-v1-english
# Orpheus voices: autumn, diana, hannah (female) · austin, daniel, troy (male)
KOEL_GROQ_VOICE=autumn

# Hindi TTS via NVIDIA Magpie (NVCF gRPC) — Orpheus is English-only. Set
# tts_hindi_provider=nvidia + an NVIDIA key to route hi/hinglish to Magpie.
KOEL_TTS_HINDI_PROVIDER=default
KOEL_TTS_NVIDIA_LANGUAGES=hi,hinglish
# KOEL_NVIDIA_API_KEY=nvapi-...
KOEL_NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
KOEL_NVIDIA_TTS_VOICE=Magpie-Multilingual
KOEL_NVIDIA_TTS_SAMPLE_RATE=44100

# Sarvam AI Bulbul (primary Hindi TTS) — set the key to enable; Sarvam then
# becomes the Hindi provider and Magpie (if also enabled) is its fallback.
# KOEL_SARVAM_API_KEY=sk_... (shared with the STT key above)
KOEL_SARVAM_TTS_MODEL=bulbul:v3
KOEL_SARVAM_SPEAKER=priya
